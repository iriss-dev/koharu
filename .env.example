# ========================================================
# Koharu (心春) · configuration
# ========================================================

# Discord application credentials
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_id_here

# Language when a server has not chosen one: es or en
DEFAULT_LOCALE=es

# Prefix for text commands (-abrazo @alguien, -anime frieren). Servers can change it with /config prefijo.
DEFAULT_PREFIX=-
# Prefix commands need "Message Content Intent" enabled in the Developer Portal.
ENABLE_PRIVILEGED_INTENTS=false

# Storage
DATABASE_PATH=./data/koharu.sqlite
DATA_DIR=./data

# Upload Koharu's emoji set as application emojis on startup (recommended)
EMOJI_SYNC=true

# Register slash commands on startup. Set DEV_GUILD_ID to register them in one
# server only while developing (updates are instant there).
DEPLOY_COMMANDS=true
DEV_GUILD_ID=

# Custom roles (0 = not sold for that currency)
DEFAULT_ROLE_COST_COINS=25000
DEFAULT_ROLE_COST_KEYS=1
BOOSTER_ROLE_FREE=true
BOOSTER_DUAL_COLOR=true

# Economy
WORK_COOLDOWN_SECONDS=300
WORK_MIN_PAYOUT=150
WORK_MAX_PAYOUT=500
DAILY_BASE=400
DAILY_STREAK_STEP=60
DAILY_STREAK_CAP=10
DAILY_WEEKLY_BONUS=500
MIN_BET=10
MAX_BET=1000000

# Deals
FREE_GAMES_INTERVAL_MINUTES=120
PRICE_ALERT_INTERVAL_MINUTES=180
MAX_ALERTS_PER_USER=10
