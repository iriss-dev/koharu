# ========================================================
# Koharu (心春) - Environment Configuration
# ========================================================

# Discord Application Credentials
# Obtain these from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_application_id_here

# Prefix for text commands (e.g. -work, -dep all, -bj 100)
DEFAULT_PREFIX=-

# Database storage path
DATABASE_PATH=./data/koharu.sqlite

# Custom Role System Defaults
# Set price in server coins (0 to disable coin purchase)
DEFAULT_ROLE_COST_COINS=25000

# Set price in Event Keys (0 to disable key purchase)
DEFAULT_ROLE_COST_KEYS=1

# Server Booster Perks
# If true, server boosters bypass costs and get custom roles for free
BOOSTER_ROLE_FREE=true

# If true, server boosters can configure dual-color gradient roles
BOOSTER_DUAL_COLOR=true

# Economy Configuration
WORK_COOLDOWN_SECONDS=300
WORK_MIN_PAYOUT=150
WORK_MAX_PAYOUT=500
